			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1639053653618</Id>
					<Name><![CDATA[enterQueue]]></Name>
					<X>910</X><Y>20</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[call]]></Name>
						<Type><![CDATA[Call]]></Type>
					</Parameter>
					<Body><![CDATA[call.waitingStartTime=time(MINUTE);
totalNumberOfCalls++;
arrivalTimes.add(call.waitingStartTime);
if(totalNumberOfCalls > 0){
totalTimeBetweenArrivals += call.waitingStartTime - lastArrivalTime;
averageTimeBetweenArrivals = totalTimeBetweenArrivals / totalNumberOfCalls;
}
lastArrivalTime = time(MINUTE);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1639055038582</Id>
					<Name><![CDATA[exitQueue]]></Name>
					<X>910</X><Y>40</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[call]]></Name>
						<Type><![CDATA[Call]]></Type>
					</Parameter>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1639055151070</Id>
					<Name><![CDATA[callStarted]]></Name>
					<X>910</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[call]]></Name>
						<Type><![CDATA[Call]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[double idleTime;
if(agent == 1){
// Able
idleTime = time(MINUTE) - AbleTime;
totalIdleTimeAble += idleTime;
}else{
// Baker
idleTime = time(MINUTE) - BakerTime;
totalIdleTimeBaker += idleTime;
}
totalIdleTime += idleTime;
idlePercent = totalIdleTime / time(MINUTE);
call.callStartTime=time(MINUTE);
double waitingTime = call.callStartTime - call.waitingStartTime;
totalWaitingTime += waitingTime;
waitingTimes.add(waitingTime);
if(waitingTime > 0){
numberOfCallersWhoWait++;
}
averageWaitingTime = totalWaitingTime / totalNumberOfCalls;
averageWaitingTimeThoseWhoWait = totalWaitingTime / numberOfCallersWhoWait;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1639055459623</Id>
					<Name><![CDATA[callEnded]]></Name>
					<X>910</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[call]]></Name>
						<Type><![CDATA[Call]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[agent]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[call.callEndTime = time(MINUTE);
double callDuration = call.callEndTime - call.callStartTime;
totalServiceTime += callDuration;
if(agent == 1){
// Able
totalServiceTimeAble += callDuration;
AbleTime = time(MINUTE);
AbleServiceTimes.add(callDuration);
}else{
// Baker
totalServiceTimeBaker += callDuration;
BakerTime = time(MINUTE);
BakerServiceTimes.add(callDuration);
}
callDurations.add(callDuration);
averageServiceTime = totalServiceTime / totalNumberOfCalls;
totalTimeSpendInSystem += time(MINUTE) - call.startupTime;
averageTimeSpendInSystem = totalTimeSpendInSystem / totalNumberOfCalls;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1639055818225</Id>
					<Name><![CDATA[destroy]]></Name>
					<X>910</X><Y>100</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[call]]></Name>
						<Type><![CDATA[Call]]></Type>
					</Parameter>
					<Body><![CDATA[waitProbability = numberOfCallersWhoWait / totalNumberOfCalls;]]></Body>
				</Function>
			</Functions>
